{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH Box",
  "version": "0.1.0",
  "identifier": "com.sshbox.app",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SSH Box",
        "width": 920,
        "height": 560,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
